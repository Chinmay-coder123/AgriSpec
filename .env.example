# Local LM Studio OpenAI-compatible endpoint
LM_STUDIO_BASE_URL=http://127.0.0.1:1234/v1
LM_STUDIO_API_KEY=lm-studio
# Must exactly match an id returned by GET /v1/models in LM Studio
LM_STUDIO_MODEL=qwen/qwen3-8b

# Local LibSQL storage for Mastra Studio memory and workflow state
MASTRA_DATABASE_URL=file:./agrispec.db
MASTRA_TELEMETRY_DISABLED=1

# Optional: folder that contains docs/ingested (defaults to the project root)
# AGRISPEC_WORKSPACE_ROOT=

# AgriSpec AI web app
AGRISPEC_HOST=127.0.0.1
AGRISPEC_PORT=4174
